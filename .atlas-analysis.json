  "keyFeatures": [
    "Interactive CLI menu with 15 independent scanning modules",
    "Pre-authentication support (Basic Auth, HTML forms, headless Playwright for SPAs/OAuth2)",
    "Web spidering with form and input detection",
    "Directory and VHost fuzzing with ffuf integration",
    "Source code analysis for secrets, API keys, and credentials in HTML/JS",
    "Nuclei integration with 10,000+ vulnerability templates",
    "Nmap port scanning with NSE script support",
    "Injection testing: SQLi, XSS, LFI, RCE, Open Redirect",
    "Advanced security tests: SSRF, SSTI, XXE, CRLF, HTTP Smuggling, Cache Poisoning",
    "OWASP API Top 10 testing: IDOR, JWT, Mass Assignment, Rate Limiting, GraphQL",
    "WordPress enumeration and attack module (WPScan integration)",
    "Active Directory pentesting: Kerbrute, LDAP, NetExec, Impacket",
    "Multi-target batch mode with per-target reports",
    "Report export in TXT, JSON, Markdown, and interactive HTML dashboard"
  ],
